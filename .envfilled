REACT_APP_ADMIN_API_KEY=admin


# Host app registration secret
HOST_APP_REGISTRATION_SECRET=host-app-secret-super-secure-change-this-in-production-987654321

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend settings
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_DEBUG=true

# =============================================================================
# LOGGING
# =============================================================================

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE=./integrati_backend/logs/integrati.log

# =============================================================================
# ANALYTICS
# =============================================================================

# Analytics settings
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_LOG_REQUESTS=true
ANALYTICS_LOG_AUTH_EVENTS=true
ANALYTICS_LOG_INTEGRATION_EVENTS=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development mode settings
AUTO_RELOAD=true
HOT_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

