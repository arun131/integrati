# Integrati Backend Environment Configuration
# This file contains example values - replace with your actual credentials

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Application settings
APP_NAME=Integrati Backend
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# Redis settings (for session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# SQLite database paths
MCP_PLEXUS_DB_PATH=./integrati_backend/data/mcp_plexus_data.sqlite3
ANALYTICS_DB_PATH=./integrati_backend/data/analytics.db


