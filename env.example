# Integrati Backend Environment Configuration
# Copy this file to the root integrati folder as .env and fill in your values

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Application settings
APP_NAME=Integrati Backend
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# Redis settings (for session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# SQLite database paths
MCP_PLEXUS_DB_PATH=./integrati_backend/data/mcp_plexus_data.sqlite3
ANALYTICS_DB_PATH=./integrati_backend/data/analytics.db

# Database URL for legacy services
DATABASE_URL=sqlite:///./app.db

# =============================================================================
# FIREBASE AUTHENTICATION
# =============================================================================

# Firebase configuration (backend)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com

# Firebase service account JSON file path (alternative to individual fields above)
FIREBASE_SERVICE_ACCOUNT_JSON=./integrati_backend/firebase-service-account.json

# Firebase configuration (frontend) - get these from Firebase Console
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# =============================================================================
# OAUTH & GOOGLE SERVICES
# =============================================================================

# Google OAuth credentials (used by legacy services and integrations)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Gmail OAuth 2.0 credentials (tenant-level)
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# Gmail API scopes
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.modify

# Calendar OAuth 2.0 credentials (tenant-level)
CALENDAR_CLIENT_ID=your-calendar-client-id.apps.googleusercontent.com
CALENDAR_CLIENT_SECRET=your-calendar-client-secret
CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/calendar/callback

# Calendar API scopes
CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/calendar.readonly

# =============================================================================
# AI & EXTERNAL SERVICES
# =============================================================================

# AI service API keys
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# MCP SERVER SETTINGS
# =============================================================================

# MCP server configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_SERVER_DEBUG=true

# FastMCP settings
FASTMCP_VERSION=2.10.0
FASTMCP_DEBUG=true

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================

# JWT settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Legacy secret key (for backward compatibility)
SECRET_KEY=your-legacy-secret-key-change-this-in-production

# Encryption keys
ENCRYPTION_KEY=your-32-character-encryption-key-for-token-storage

# Admin API key for tenant management (used by frontend)
ADMIN_API_KEY=your-admin-api-key-change-this-in-production
REACT_APP_ADMIN_API_KEY=your-admin-api-key-change-this-in-production

# Host app registration secret
HOST_APP_REGISTRATION_SECRET=your-host-app-secret-change-this-in-production

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend settings
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_DEBUG=true

# =============================================================================
# LOGGING
# =============================================================================

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE=./integrati_backend/logs/integrati.log

# =============================================================================
# ANALYTICS
# =============================================================================

# Analytics settings
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_LOG_REQUESTS=true
ANALYTICS_LOG_AUTH_EVENTS=true
ANALYTICS_LOG_INTEGRATION_EVENTS=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development mode settings
AUTO_RELOAD=true
HOT_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# =============================================================================
# PRODUCTION SETTINGS (uncomment for production)
# =============================================================================

# PRODUCTION_HOST=0.0.0.0
# PRODUCTION_PORT=8000
# PRODUCTION_WORKERS=4
# PRODUCTION_DEBUG=false
# PRODUCTION_LOG_LEVEL=WARNING

# =============================================================================
# DOCKER SETTINGS (if using Docker)
# =============================================================================

# Docker-specific settings
DOCKER_REDIS_HOST=redis
DOCKER_REDIS_PORT=6379
DOCKER_DATA_PATH=/app/data
