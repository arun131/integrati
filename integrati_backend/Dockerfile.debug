# Use Python 3.11 slim image
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV UV_CACHE_DIR=/tmp/uv-cache

# Install system dependencies and Google Cloud SDK
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    ca-certificates \
    apt-transport-https \
    lsb-release \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
        | tee -a /etc/apt/sources.list.d/google-cloud-sdk.list \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update && apt-get install -y google-cloud-sdk \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Set work directory
WORKDIR /app

# Copy uv configuration files
COPY pyproject.toml uv.lock* ./

# Copy application code
COPY . .

# Install dependencies with uv (much faster)
RUN uv pip install --system -r requirements.txt && \
    uv pip install --system debugpy

# Make scripts executable
RUN chmod +x /app/bootstrap_and_run.sh
RUN chmod +x /app/setup_debug_tunnel.sh

# Set Python path
ENV PYTHONPATH="/usr/local/lib/python3.11/site-packages:$PYTHONPATH"

# Create data directory
RUN mkdir -p /app/data

# Verify debugpy installation and Python path
RUN python --version && \
    python -c "import debugpy; print('debugpy version:', debugpy.__version__)" && \
    python -c "import sys; print('Python path:', sys.executable)" && \
    python -c "import sys; print('Python packages:', sys.path)"

# Expose ports
EXPOSE 8000 5678

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command (can be overridden in docker-compose)
CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", "--wait-for-client", "-m", "uvicorn", "mcp_plexus.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
